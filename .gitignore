# Build/run artifacts (all Vivado outputs land here)
output/

# Bare-metal software build output (sw/startup.S, sw/main.c -> sw/build/*.elf)
sw/build/

# Vivado project-level cruft that can appear outside output/
.Xil/
*.jou
*.log
*.str
*.backup.jou
*.pb
webtalk*.jou
webtalk*.log
usage_statistics_webtalk.html
.Rerun_*
*.zip
xsim.dir/
dfx_runtime.txt

# JVM crash dumps Vivado sometimes leaves behind
hs_err_pid*.log
hs_err_pid*.dmp

# Internal-only material: debugging notes, vendor reference docs, scratch/
# test firmware, one-off diagnostic scripts. Useful to us, not part of the
# project's actual PL/PS functionality, never meant to be tracked.
private/

# Tool config directories -- must stay at this exact path for the tools
# themselves to find them, so they're gitignored in place rather than
# moved into private/.
.claude/
.vscode/

# Python bytecode cache
__pycache__/

# Build flow, pin/timing constraints, PS7 block design, and internal
# docs -- this repo tracks RTL (src/*.sv, *.hex), testbenches (tb/),
# tools (tools/), firmware (sw/), and README.md only. Everything below
# stays local (not needed to replicate the build or reuse the code).
scripts/
constraints/
# src/PS/ is excluded except design_1.bd -- the actual source of truth
# for the PS7 config (scripts/ps7.tcl regenerates the .xci/.bda/HDL from
# this alone; those regenerated files aren't needed for replicability).
src/PS/*
!src/PS/bd/
src/PS/bd/*
!src/PS/bd/design_1/
src/PS/bd/design_1/*
!src/PS/bd/design_1/design_1.bd
setup_env.bat
setup_env.ps1
explanation.md
rds_decoding.md
bringup_log.md
CLAUDE.md

# Pictures/plots -- generated analysis output, not source.
*.jpg
*.png

# Dead code, not instantiated anywhere -- kept locally in case it's
# useful again, not part of the tracked RTL.
src/axi_interconnect.sv